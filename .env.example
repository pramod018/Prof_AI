# Cisco CX AI Playground JWT token (required for LLM summarization)
CXAI_PLAYGROUND_ACCESS_TOKEN=your-jwt-token-here

# Cisco CX AI Playground base URL
OPENAI_BASE_URL=https://cxai-playground.cisco.com

# Embedding model (runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM model for summarization
LLM_MODEL=gpt-4o-mini

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Collection name in ChromaDB
CHROMA_COLLECTION=bems_tickets

# Number of results to retrieve per query
TOP_K=5

# Server settings
HOST=0.0.0.0
PORT=8000

# Fine-tuning settings (optional)
FINETUNE_OUTPUT_DIR=./finetuned_model
FINETUNE_WARMUP_RATIO=0.1
